{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onchain-market-data-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "kv_namespaces": [
    {
      "binding": "MARKET_CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
